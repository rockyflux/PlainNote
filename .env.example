# Storage: set BOTH below → Turso; leave URL unset → local SQLite.
# URL without token → startup fails (no silent fallback).
# Free plan: https://turso.tech/pricing

TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# Optional overrides (also available as CLI flags)
# PORT=3123
# HOST=0.0.0.0
# DB_PATH=
# ADMIN_PASSWORD=
# SENSITIVE_PATH=
# PLAINNOTE_NO_UPDATE=1
