# Storage: set BOTH below → Turso; leave URL unset → local SQLite (CLI only).
# URL without token → startup fails (no silent fallback).
# Free plan: https://turso.tech/pricing
# Required on Vercel (no local SQLite).

TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# Admin UI (/admin). On Vercel: env only (no admin.password file).
# Local CLI: optional — first run writes ~/.plainnote/admin.password when unset.
# ADMIN_PASSWORD=

# Optional overrides (also available as CLI flags)
# PORT=3123
# HOST=0.0.0.0
# DB_PATH=
# SENSITIVE_PATH=
# PLAINNOTE_NO_UPDATE=1
# PLAINNOTE_EPHEMERAL_ADMIN=1
