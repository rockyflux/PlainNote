{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/static",
  "installCommand": "npm ci",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{dist/server/data/**,src/server/data/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/raw", "destination": "/api" },
    { "source": "/raw/(.*)", "destination": "/api" },
    { "source": "/edit/:secret", "destination": "/index.html" },
    { "source": "/note/:id", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/docs", "destination": "/index.html" },
    { "source": "/zh/docs", "destination": "/index.html" }
  ]
}
