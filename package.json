{
  "name": "plainshare",
  "version": "0.1.3",
  "description": "Anonymous Markdown notes with a shareable web view and a curl-friendly raw text link.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "plainnote": "dist/cli.js"
  },
  "main": "./dist/server/index.js",
  "files": [
    "dist",
    "run.sh"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev:server": "tsx watch src/cli.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.json && node scripts/copy-server-data.mjs",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/cli.js",
    "pack": "npm pack --pack-destination .",
    "test": "node test/sanitize.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "better-sqlite3": "^11.10.0",
    "commander": "^12.1.0",
    "dompurify": "^3.1.7",
    "fastify": "^4.28.1",
    "marked": "^12.0.2",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.14.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite": "^5.3.4"
  }
}
